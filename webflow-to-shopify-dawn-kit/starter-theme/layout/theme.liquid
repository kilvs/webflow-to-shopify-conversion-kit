{%- comment -%}
  Dawn-augmented theme layout.

  Strategy:
    Brand pages (home, about, contact, /pages/*, blog, articles, 404,
    password) render with WEBFLOW's markup + CSS + JS.
    Commerce pages (product, collection, cart, search, customers/*)
    render with DAWN's templates + web components.
    Header & footer are Webflow-styled and shared across both.

  CSS conflicts between the two are resolved by cascade layers declared
  below: `@layer dawn, webflow;`. Webflow's @layer webflow wins on
  shared selectors (e.g. if both define `.button`, Webflow's rules apply
  on every page). Cascade layers respect the layer order regardless of
  selector specificity.

  PLACEHOLDERS to fill in after running scripts/audit-source:
    <YOUR_WF_SITE_ID>      — constant data-wf-site (grep AUDIT.md)
    <WF_PAGE_*>            — per-template data-wf-page IDs
    <WEBFLOW_BUNDLE>       — your Webflow JS bundle filename in assets/
    <WEBFLOW_PRIMARY_CSS>  — your brand's primary CSS file (e.g. brand.webflow.css)
{%- endcomment -%}
{%- liquid
  case template
    when 'index'
      assign wf_page_id = '<WF_PAGE_INDEX>'
    when 'page.about'
      assign wf_page_id = '<WF_PAGE_ABOUT>'
    when 'page.contact'
      assign wf_page_id = '<WF_PAGE_CONTACT>'
    when 'page'
      assign wf_page_id = '<WF_PAGE_GENERIC_PAGE>'
    when 'blog'
      assign wf_page_id = '<WF_PAGE_BLOG>'
    when 'article'
      assign wf_page_id = '<WF_PAGE_ARTICLE>'
    when '404'
      assign wf_page_id = '<WF_PAGE_404>'
    else
      assign wf_page_id = '<WF_PAGE_INDEX>'
  endcase
-%}
<!DOCTYPE html>
<html data-wf-page="{{ wf_page_id }}" data-wf-site="<YOUR_WF_SITE_ID>" lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%}
    CASCADE LAYERS — declared BEFORE any stylesheet so the cascade can
    resolve Dawn vs Webflow precedence. Webflow wins on shared selectors.
    Layer wrapping is applied per-file by flatten-assets (Webflow) and
    merge-dawn-commerce (Dawn).
  {%- endcomment -%}
  <style>@layer dawn, webflow;</style>

  {%- comment -%} DAWN — global base. Commerce sections load their own component-*.css from within. {%- endcomment -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {%- comment -%} WEBFLOW — brand stylesheets. Rename below to match assets/ filenames from AUDIT.md. {%- endcomment -%}
  {{ 'normalize.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  {{ '<WEBFLOW_PRIMARY_CSS>' | asset_url | stylesheet_tag }}{%- comment -%} ⇐ rename to your site's primary CSS file {%- endcomment -%}
  {% render 'theme-variables' %}

  {%- comment -%} Shopify routes / locale / cart object — Dawn's web components rely on these. {%- endcomment -%}
  <script>
    window.Shopify = window.Shopify || {};
    Shopify.routes = {
      root: '{{ routes.root_url }}',
      account_url: '{{ routes.account_url }}',
      account_addresses_url: '{{ routes.account_addresses_url }}',
      account_register_url: '{{ routes.account_register_url }}',
      account_login_url: '{{ routes.account_login_url }}',
      cart_url: '{{ routes.cart_url }}',
      cart_add_url: '{{ routes.cart_add_url }}',
      cart_change_url: '{{ routes.cart_change_url }}',
      cart_update_url: '{{ routes.cart_update_url }}',
      collections_url: '{{ routes.collections_url }}',
      search_url: '{{ routes.search_url }}'
    };
    Shopify.money_format = {{ shop.money_format | json }};
    Shopify.locale = {{ request.locale.iso_code | json }};
    Shopify.currency = { active: {{ cart.currency.iso_code | json }}, rate: '1.0' };
  </script>

  {%- if settings.seo_default_description != blank and page_description == blank -%}
    <meta name="description" content="{{ settings.seo_default_description | escape }}">
  {%- endif -%}
  {%- if settings.social_share_image != blank -%}
    <meta property="og:image" content="{{ settings.social_share_image | image_url: width: 1200 }}">
    <meta name="twitter:card" content="summary_large_image">
  {%- endif -%}

  {%- comment -%} Webflow JS detector — force w-mod-ix3 so interaction-aware CSS rules apply unconditionally. {%- endcomment -%}
  <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js"+t+"ix3",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>

  {%- comment -%} DAWN — runtime JS (deferred). Web components register on load and are no-ops on pages that don't use them. {%- endcomment -%}
  <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

  {%- if settings.favicon != blank -%}
    <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 32 }}" type="image/png">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
  {%- else -%}
    <link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png">
    <link rel="apple-touch-icon" href="{{ 'webclip.png' | asset_url }}">
  {%- endif -%}

  {%- comment -%} If your export uses Swiper, include the CDN here. {%- endcomment -%}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

  {%- comment -%}
    Inline Swiper helpers + per-export init helpers go here.
    Lift them verbatim from any of your source HTML pages' <head> <script> blocks
    (they're identical across pages).
  {%- endcomment -%}

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}{% if template.suffix %} template-suffix-{{ template.suffix | handle }}{% endif %}">
  <div class="page-wrapper">
    {%- comment -%}
      If your export has a cursor element / global-styles inline <style> block
      / other page-wrapper-level content, lift it verbatim from any source
      HTML page (e.g. index.html lines ~200-420) and paste here.
    {%- endcomment -%}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </div>

  {%- comment -%}
    Dawn's cart drawer — rendered globally so any Webflow "Add to cart" link
    on a brand page can trigger it via window.cartDrawer or by dispatching
    Dawn's `cart:open` event. See DAWN_INTEGRATION.md for the integration
    snippet to wire Webflow buttons.
  {%- endcomment -%}
  {% section 'cart-drawer' %}

  {%- comment -%} WEBFLOW — JS bundle at end of body, per Webflow convention. {%- endcomment -%}
  <script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=<YOUR_WF_SITE_ID>" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script>
  <script src="{{ '<WEBFLOW_BUNDLE>.js' | asset_url }}" type="text/javascript"></script>{%- comment -%} ⇐ your site's main Webflow JS bundle {%- endcomment -%}
  <script src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js" type="text/javascript"></script>
  <script src="https://cdn.prod.website-files.com/gsap/3.15.0/SplitText.min.js" type="text/javascript"></script>
  <script src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js" type="text/javascript"></script>
</body>
</html>
